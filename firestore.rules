rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function updatesOnlySosStatus() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["status", "updatedAt"]);
    }

    // Users can only read or update their own profile document.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Emergency contacts are private to the authenticated user who owns them.
    // Mobile queries this collection with where("userId", "==", request.auth.uid).
    match /emergency_contacts/{contactId} {
      // Create/update must keep request.resource.data.userId equal to the current user.
      allow create: if ownsIncomingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();

      // Read/delete must only target documents already owned by the current user.
      allow read, delete: if ownsExistingDocument();
    }

    // Journey sessions are private to the authenticated user who owns them.
    // Mobile queries this collection with where("userId", "==", request.auth.uid).
    match /journeys/{journeyId} {
      // Create/update must keep userId equal to the current user's Firebase Auth UID.
      allow create: if ownsIncomingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();

      // Read/delete only allow documents already owned by the current user.
      allow read, delete: if ownsExistingDocument();
    }

    // SOS alerts are private to the authenticated user who created them.
    // Mobile queries this collection with where("userId", "==", request.auth.uid).
    match /sos_alerts/{alertId} {
      allow create: if ownsIncomingDocument();
      allow read: if ownsExistingDocument();

      // MVP only allows the owner to update status fields, for example resolved/cancelled.
      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && updatesOnlySosStatus();
      allow delete: if false;
    }

    // Authenticated users can read demo vehicle status data. Clients cannot write it.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny every future collection until explicit rules are reviewed and added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
