rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function updatesOnlySosStatus() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["status", "updatedAt"]);
    }

    // Users can only read or update their own profile document.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Emergency contacts are private to the authenticated user who owns them.
    // Mobile queries this collection with where("userId", "==", request.auth.uid).
    match /emergency_contacts/{contactId} {
      // Create/update must keep request.resource.data.userId equal to the current user.
      allow create: if ownsIncomingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();

      // Read/delete must only target documents already owned by the current user.
      allow read, delete: if ownsExistingDocument();
    }

    // Journey sessions are private to the authenticated user who owns them.
    // Mobile queries this collection with where("userId", "==", request.auth.uid).
    match /journeys/{journeyId} {
      // Create/update must keep userId equal to the current user's Firebase Auth UID.
      allow create: if ownsIncomingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument()
        && request.resource.data.get('metadata', {}).get('vehiclePlate', '')
          == resource.data.get('metadata', {}).get('vehiclePlate', '');

      // Read/delete only allow documents already owned by the current user.
      // A read of a journey that does not exist yet is also allowed: it reveals
      // nothing, and the app starts listening to a new journey the moment it is
      // written locally, before the server has the document. Denying that read
      // kills the listener with permission-denied.
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if ownsExistingDocument();
    }

    // SOS alerts are private to the authenticated user who created them.
    // Mobile queries this collection with where("userId", "==", request.auth.uid).
    match /sos_alerts/{alertId} {
      allow create: if ownsIncomingDocument();
      allow read: if ownsExistingDocument();

      // MVP only allows the owner to update status fields, for example resolved/cancelled.
      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && updatesOnlySosStatus();
      allow delete: if false;
    }

    // Authenticated users can read demo vehicle status data. Clients cannot write it.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // One immutable passenger review per completed journey. Only the server
    // updates vehicle aggregates; clients cannot choose a different plate.
    match /vehicle_reviews/{journeyId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/vehicle_reviews/$(journeyId))
        || ownsExistingDocument());
      allow list: if ownsExistingDocument();
      allow create: if ownsIncomingDocument()
        && request.resource.data.keys().hasOnly([
          'userId', 'vehiclePlate', 'stars', 'createdAt'
        ])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.status == 'safe'
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.metadata.vehiclePlate == request.resource.data.vehiclePlate;
      allow update, delete: if false;
    }

    // Deny every future collection until explicit rules are reviewed and added.
    match /vehicle_safety_events/{journeyId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/vehicle_safety_events/$(journeyId))
        || ownsExistingDocument());
      allow list: if ownsExistingDocument();
      allow create: if ownsIncomingDocument()
        && request.resource.data.keys().hasOnly(['userId', 'vehiclePlate', 'type', 'createdAt'])
        && request.resource.data.type == 'unanswered_safety_check'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.metadata.vehiclePlate == request.resource.data.vehiclePlate
        && request.time >= get(/databases/$(database)/documents/journeys/$(journeyId)).data.estimatedEndTime + duration.value(180, 's');
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
