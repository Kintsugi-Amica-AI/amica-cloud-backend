rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function updatesOnlySosStatus() {
      // The app also records who its SOS text reached.
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["status", "updatedAt", "notifiedContacts", "deliveryReport"]);
    }

    // A profile may only claim `phoneVerified: true` for the number that is
    // actually linked to the Firebase Auth account (proved by SMS code), so
    // a client cannot mark an arbitrary number as verified.
    function phoneVerificationIsGenuine() {
      return request.resource.data.get('phoneVerified', false) != true
        || request.resource.data.get('phone', '')
          == request.auth.token.get('phone_number', '');
    }

    // True when an update leaves `phone` and `phoneVerified` untouched.
    // Saving a name or settings must not be re-judged on the phone claim:
    // a profile verified earlier would otherwise reject every later write
    // whenever the ID token lacks a matching `phone_number`.
    function phoneFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['phone', 'phoneVerified']);
    }

    // Users can only read or update their own profile document.
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && phoneVerificationIsGenuine();
      allow update: if isOwner(userId)
        && (phoneFieldsUnchanged() || phoneVerificationIsGenuine());
    }

    // Emergency contacts are private to the authenticated user who owns them.
    // Mobile queries this collection with where("userId", "==", request.auth.uid).
    // `guardianUid` links a contact to their own Amica account so alerts reach
    // them as push notifications. Only the server sets it (after the contact
    // enters an invite code texted to their number); the owner may remove it,
    // for example when the contact's phone number changes.
    function guardianLinkUntouchedOrRemoved() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['guardianUid', 'guardianName', 'guardianLinkedAt'])
        || !request.resource.data.keys()
          .hasAny(['guardianUid', 'guardianName', 'guardianLinkedAt']);
    }

    match /emergency_contacts/{contactId} {
      // Create/update must keep request.resource.data.userId equal to the current user.
      allow create: if ownsIncomingDocument()
        && !request.resource.data.keys()
          .hasAny(['guardianUid', 'guardianName', 'guardianLinkedAt']);
      allow update: if ownsExistingDocument() && ownsIncomingDocument()
        && guardianLinkUntouchedOrRemoved();

      // Read/delete must only target documents already owned by the current user.
      allow read, delete: if ownsExistingDocument();
    }

    // Journey sessions are private to the authenticated user who owns them.
    // Mobile queries this collection with where("userId", "==", request.auth.uid).
    match /journeys/{journeyId} {
      // Create/update must keep userId equal to the current user's Firebase Auth UID.
      allow create: if ownsIncomingDocument();
      // `liveShare` (the watch-live link) is written only by the server.
      allow update: if ownsExistingDocument() && ownsIncomingDocument()
        && request.resource.data.get('metadata', {}).get('vehiclePlate', '')
          == resource.data.get('metadata', {}).get('vehiclePlate', '')
        && request.resource.data.get('liveShare', null)
          == resource.data.get('liveShare', null);

      // Read/delete only allow documents already owned by the current user.
      // A read of a journey that does not exist yet is also allowed: it reveals
      // nothing, and the app starts listening to a new journey the moment it is
      // written locally, before the server has the document. Denying that read
      // kills the listener with permission-denied.
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if ownsExistingDocument();
    }

    // SOS alerts are private to the authenticated user who created them.
    // Mobile queries this collection with where("userId", "==", request.auth.uid).
    match /sos_alerts/{alertId} {
      allow create: if ownsIncomingDocument();
      // As for journeys: the SOS screen listens to a new alert (for guardian
      // replies) before the server has it, so a missing document is readable.
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);

      // MVP only allows the owner to update status fields, for example resolved/cancelled.
      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && updatesOnlySosStatus();
      allow delete: if false;
    }

    // Authenticated users can read demo vehicle status data. Clients cannot write it.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // One immutable passenger review per completed journey. Only the server
    // updates vehicle aggregates; clients cannot choose a different plate.
    match /vehicle_reviews/{journeyId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/vehicle_reviews/$(journeyId))
        || ownsExistingDocument());
      allow list: if ownsExistingDocument();
      allow create: if ownsIncomingDocument()
        && request.resource.data.keys().hasOnly([
          'userId', 'vehiclePlate', 'stars', 'comment', 'createdAt'
        ])
        && request.resource.data.stars is int
        && (!('comment' in request.resource.data)
          || (request.resource.data.comment is string
            && request.resource.data.comment.size() >= 1
            && request.resource.data.comment.size() <= 1000))
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.status == 'safe'
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.metadata.vehiclePlate == request.resource.data.vehiclePlate;
      allow update, delete: if false;
    }

    // Deny every future collection until explicit rules are reviewed and added.
    match /vehicle_safety_events/{journeyId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/vehicle_safety_events/$(journeyId))
        || ownsExistingDocument());
      allow list: if ownsExistingDocument();
      allow create: if ownsIncomingDocument()
        && request.resource.data.keys().hasOnly(['userId', 'vehiclePlate', 'type', 'createdAt'])
        && request.resource.data.type == 'unanswered_safety_check'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.metadata.vehiclePlate == request.resource.data.vehiclePlate
        && request.time >= get(/databases/$(database)/documents/journeys/$(journeyId)).data.estimatedEndTime + duration.value(180, 's');
      allow update, delete: if false;
    }

    // What the camera saw of a vehicle: type and colour words only, never
    // a photo. One per user per plate (id `{plate}_{uid}`) and immutable,
    // so re-scanning cannot tip a plate's community profile. Only the
    // onVehicleObservationCreated function writes the vehicles aggregate.
    match /vehicle_observations/{observationId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/vehicle_observations/$(observationId))
        || ownsExistingDocument());
      allow list: if ownsExistingDocument();
      allow create: if ownsIncomingDocument()
        && request.resource.data.keys().hasAll(['userId', 'vehiclePlate', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'userId', 'vehiclePlate', 'vehicleType', 'colour', 'createdAt'
        ])
        && request.resource.data.keys().hasAny(['vehicleType', 'colour'])
        && request.resource.data.vehiclePlate is string
        && request.resource.data.vehiclePlate.matches('^[A-Z]{2,3}[0-9]{4}$')
        && observationId == request.resource.data.vehiclePlate + '_' + request.auth.uid
        && request.resource.data.get('vehicleType', 'car') in [
          'car', 'van', 'bus', 'lorry', 'motorbike', 'three_wheeler'
        ]
        && request.resource.data.get('colour', 'white') in [
          'white', 'silver', 'grey', 'black', 'red', 'maroon',
          'orange', 'yellow', 'green', 'blue', 'brown'
        ]
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Push notification tokens, one document per device token. A token that
    // moves to another account (sign-out, sign-in) is simply re-claimed.
    match /fcm_tokens/{token} {
      allow read, delete: if ownsExistingDocument();
      allow create, update: if ownsIncomingDocument()
        && request.resource.data.keys().hasOnly(['userId', 'platform', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // live_shares (watch-live pages) and guardian_invites are server-only:
    // the page reads a trimmed view through the liveJourney function.

    // Website contact form: server-only. The submitContactMessage function
    // writes them with the Admin SDK; nobody can read them from a client.
    // Read them in the Firebase console (see docs/contact_form_setup.md).
    match /contact_messages/{messageId} {
      allow read, write: if false;
    }
    match /contact_rate_limits/{senderHash} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
